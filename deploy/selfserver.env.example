# Copy to /etc/selfserver/selfserver.env and edit values.
# Generate a strong value with: openssl rand -hex 32
SELFTUNNEL_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
SELFTUNNEL_CONTROL_BIND=0.0.0.0:9000
SELFTUNNEL_PUBLIC_BIND=0.0.0.0:25565
SELFTUNNEL_TLS_CERT=/etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem
SELFTUNNEL_TLS_KEY=/etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem
